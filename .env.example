# ⚠️ זה קובץ דוגמה בלבד! העתקו ל-.env ועדכנו את הערכים.
# DO NOT commit your .env file with real credentials to git!

# PostgreSQL Environment Variables (שנה ערכים אלה בפועל!)
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=learning_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL for SQLAlchemy
DATABASE_URL=postgresql://your_db_user:your_secure_password@postgres:5432/learning_platform

# FastAPI Settings
FASTAPI_ENV=development
# FASTAPI_DEBUG הוא משתנה אופציונלי ולא בהכרח נחוץ לריצה ב-Docker Compose
FASTAPI_DEBUG=false

# JWT Authentication
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Service Configuration
USE_MOCK_AI=false
OPENAI_API_KEY=your_openai_api_key_here

# Bootstrap admin user (optional)
FIRST_ADMIN_NAME=admin
FIRST_ADMIN_LAST_NAME=admin
FIRST_ADMIN_PHONE=0500000000
FIRST_ADMIN_PASSWORD=admin123